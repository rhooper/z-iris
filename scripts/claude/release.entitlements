<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the released apps (build_release.sh).
     PyObjC and ctypes build call trampolines at run time through libffi,
     which needs writable executable memory. 2026-10-21. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
